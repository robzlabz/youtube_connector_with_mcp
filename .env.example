# ---------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
# OAuth 2.0 Client ID, application type: Web application
# Authorized redirect URI must be exactly: http://localhost:3000/oauth2callback
#
# Copy this file to .env and replace the two placeholders below.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Local port for the UI, REST API and the MCP endpoint (/mcp)
PORT=3000

# Optional overrides
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube
# MAX_UPLOAD_MB=2048
# HOST=127.0.0.1
# TOKEN_FILE=data/tokens.json
